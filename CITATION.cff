cff-version: 1.2.0
message: >-
  If you use this software in your research, please cite it using the
  metadata below. This citation reflects the current release; see the
  "Version History" table in README.md for citations of prior releases
  and their individual DOIs.
title: "Vibe Up 2.0"
type: software
# Uncomment and fill in when the first snapshot is tagged and archived:
# version: "yyyy.mm.dd"               # update on each release
# date-released: "yyyy-mm-dd"         # update on each release
doi: "10.xxxx/zenodo.xxxxxxx"         # this release's DOI (filled in after Zenodo archives the tag)
repository: "https://github.com/a2i2/bdi-vibe-up-2-doi"
license: "CC-BY-4.0"   # e.g. CC-BY-4.0 for the docs/metadata, NOT the software license
abstract: >-
  The Vibe Up 2.0 mobile apps running on the Conductor platform delivers intervention content and survey measures pertaining to the Wellcome study.
  This is a public citation and release-log record for Vibe Up 2.0, which is closed-source. This repository contains release notes, changelogs, and citation metadata only; it does not contain source code.
authors:
  - family-names: "Funke Kupper"
    given-names: "Joost"
    orcid: "https://orcid.org/0009-0009-6067-1782"
    affiliation: "Deakin University"
  - family-names: "Cameron"
    given-names: "Stuart"
    orcid: "https://orcid.org/0000-0002-7862-3051"
    affiliation: "Deakin University"
  - family-names: "Manoglou"
    given-names: "Nicholas"
    orcid: "https://orcid.org/0000-0002-7862-3051"
    affiliation: "Deakin University"
  # - add additional authors as needed
identifiers:
  - type: doi
    value: "10.xxxx/zenodo.xxxxxxx"   # concept DOI (always resolves to latest version)
    description: "This DOI represents all versions and will always resolve to the latest one."
  - type: other
    value: "Android v2.2.2"
    description: "Android app version included in this snapshot."
  - type: other
    value: "iOS v2.1.0"
    description: "iOS app version included in this snapshot."
keywords:
  - Black Dog Institute
  - Android and iOS
contact:
  - email: "a2i2-admin@deakin.edu.au"
